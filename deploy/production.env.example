# Copy to deploy/production.env on the server. Never commit the filled-in file.
APP_REVISION=""                 # git commit being deployed, e.g. $(git rev-parse --short HEAD)
API_DOMAIN="api.example.com"    # DNS A record must point at this VM

# Database: EITHER Postgres on this VM (set POSTGRES_PASSWORD; DATABASE_URL is then ignored) ...
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=""
# ... OR a managed Postgres with pgvector, e.g. Neon (direct, non-pooled host):
DATABASE_URL="postgresql://user:password@host:5432/hirelens?sslmode=require"

# Same value as the inference Lambda's ML_SERVICE_TOKEN. Generate: openssl rand -hex 32
ML_SERVICE_TOKEN=""

# Inference runs in the "ml" container on this VM by default (see docker-compose.prod.yml).
# Only if you deploy it to AWS Lambda instead (apps/ml-service/scripts/deploy_aws.sh):
# ML_LAMBDA_FUNCTION="hirelens-inference"
# AWS_REGION="ap-south-1"
# AWS_ACCESS_KEY_ID=""        # IAM user limited to lambda:InvokeFunction on that function
# AWS_SECRET_ACCESS_KEY=""

# Exact web origin(s) serving the static site, comma-separated. No wildcards.
CORS_ORIGIN="https://hirelens.example.com"
# Caddy's fixed address on the compose network: the only proxy whose forwarded IPs are trusted.
TRUST_PROXY="172.28.0.10"

# Seconds per inference attempt (10-140); keep above the Lambda timeout (LAMBDA_TIMEOUT in deploy_aws.sh).
INFERENCE_TIMEOUT_SECONDS=90

# Tracing (OpenTelemetry). Defaults to the jaeger service in docker-compose.prod.yml; set it to
# empty to turn tracing off. Jaeger's UI binds to 127.0.0.1 on JAEGER_UI_PORT (default 16686).
# OTEL_EXPORTER_OTLP_ENDPOINT="http://jaeger:4318"
# JAEGER_UI_PORT=16686
