{
  "name": "hirelens",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace apps/api",
    "dev:worker": "npm run worker --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "test": "npm run test --workspace apps/api",
    "test:ml": "cd apps/ml-service && .venv/bin/python -m pytest -q"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
