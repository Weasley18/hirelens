# --- apps/api + worker ---
# Local docker-compose Postgres, or a Neon connection string (use the
# non-pooler host for Prisma migrations). Copy this file to .env.
DATABASE_URL="postgresql://hirelens:hirelens@localhost:5432/hirelens"
REDIS_URL="redis://localhost:6379"
ML_SERVICE_URL="http://localhost:8000"
PORT=3000
# If those host ports are already taken, remap in docker-compose.override.yml
# and set REDIS_URL / ML_SERVICE_URL / PORT to match.
# Comma-separated exact browser origins; wildcards are rejected.
CORS_ORIGIN="http://localhost:3001"
# Required by API/worker and ML service. Generate with: openssl rand -hex 32
ML_SERVICE_TOKEN=""
# Production worker: IAM lambda:InvokeFunction on this function only.
# ML_LAMBDA_FUNCTION="hirelens-inference"
# AWS_REGION="ap-south-1"
# Set NODE_ENV=production for API/worker and APP_ENV=production for ML in production.
# Configure only your actual proxy CIDRs, never blanket trust of forwarded headers.
TRUST_PROXY=""

# --- apps/ml-service ---
# stub = deterministic fake analysis (works before Phase 4/5 finish)
# gguf = real fine-tuned model
MODEL_BACKEND="stub"
MODEL_PATH="./hirelens-q4.gguf"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# --- data generation only (Phase 3, local, never in prod) ---
# Gemini is the default teacher if GEMINI_API_KEY is set; otherwise OpenAI.
GEMINI_API_KEY=""
OPENAI_API_KEY=""
# TEACHER_PROVIDER="openai"
# TEACHER_MODEL="gpt-4o-mini"

# --- apps/web ---
NEXT_PUBLIC_API_URL="http://localhost:3000"
