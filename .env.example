# --- apps/api + worker ---
# Local docker-compose Postgres, or a Neon connection string (use the
# non-pooler host for Prisma migrations). Copy this file to .env.
DATABASE_URL="postgresql://hirelens:hirelens@localhost:5432/hirelens"
REDIS_URL="redis://localhost:6379"
ML_SERVICE_URL="http://localhost:8000"
PORT=3000
# If those host ports are already taken, remap in docker-compose.override.yml
# and set REDIS_URL / ML_SERVICE_URL / PORT to match.
# Comma-separated exact browser origins; wildcards are rejected.
CORS_ORIGIN="http://localhost:3001"
# Required by API/worker and ML service. Generate with: openssl rand -hex 32
ML_SERVICE_TOKEN=""
# Production worker: IAM lambda:InvokeFunction on this function only.
# ML_LAMBDA_FUNCTION="hirelens-inference"
# AWS_REGION="ap-south-1"
# Set NODE_ENV=production for API/worker and APP_ENV=production for ML in production.
# Configure only your actual proxy CIDRs, never blanket trust of forwarded headers.
TRUST_PROXY=""

# --- apps/ml-service ---
# stub   = deterministic keyword-based fake analysis (no model; labelled as a demo in the UI)
# hosted = a provider's model API generates the analysis (no training needed)
# gguf   = the self-hosted fine-tuned model in MODEL_PATH
MODEL_BACKEND="stub"
MODEL_PATH="./hirelens-q4.gguf"
# Hosted backend: provider and model. The key comes from OPENAI_API_KEY / ANTHROPIC_API_KEY /
# GEMINI_API_KEY below. Candidate documents are sent to this provider.
HOSTED_PROVIDER="openai"
# HOSTED_MODEL="gpt-6-luna"           # default; gpt-6.1-terra is stronger at ~10x the price
# HOSTED_REASONING_EFFORT="medium"    # OpenAI only: none | low | medium | high
# HOSTED_TIMEOUT_SECONDS=60          # total for one analysis, including a retry
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# --- provider API keys: hosted backend, and data generation (Phase 3) ---
# Teacher is picked by the first key set: Gemini, then OpenAI, then Anthropic (Claude).
# Or force one with TEACHER_PROVIDER=gemini|openai|anthropic.
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# TEACHER_PROVIDER="anthropic"
# TEACHER_MODEL="claude-sonnet-5-5"

# --- apps/web ---
VITE_API_URL="http://localhost:3000"
# With MODEL_BACKEND=hosted, the provider's name for the privacy notice (e.g. "OpenAI").
VITE_INFERENCE_PROVIDER=""

# Worker: seconds to wait for one inference attempt (10-140). Keep above the Lambda timeout.
# INFERENCE_TIMEOUT_SECONDS=90
