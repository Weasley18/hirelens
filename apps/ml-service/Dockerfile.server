# ML service as a plain HTTP server (uvicorn) for running next to the API on one VM, with
# MODEL_BACKEND=hosted. No llama.cpp, compiler or model file. Works on x86-64 and ARM (Ampere).
# Build from the repository root: docker build -f apps/ml-service/Dockerfile.server .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    HF_HOME=/opt/hf HF_HUB_OFFLINE=0
WORKDIR /app

COPY apps/ml-service/requirements.txt /tmp/requirements.txt
# CPU-only torch keeps the image small (the default wheel bundles CUDA on x86-64).
RUN grep -v -e '^llama-cpp-python' -e '^mangum' /tmp/requirements.txt > /tmp/requirements-server.txt \
    && pip install --extra-index-url https://download.pytorch.org/whl/cpu -r /tmp/requirements-server.txt \
       uvicorn==0.32.0 \
    && rm /tmp/requirements*.txt

# Bake the embedding model in, then forbid downloads at runtime (the filesystem is read-only).
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('BAAI/bge-small-en-v1.5')"
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1

COPY apps/ml-service/common.py ./
COPY packages/shared/analysis.schema.json ./
COPY apps/ml-service/inference/ ./inference/
COPY apps/ml-service/rag/ ./rag/

ENV APP_ENV=production MODEL_BACKEND=hosted
RUN useradd --system --uid 10001 ml && chown -R ml /opt/hf
USER ml
EXPOSE 8000
CMD ["uvicorn", "inference.server:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-server-header"]
