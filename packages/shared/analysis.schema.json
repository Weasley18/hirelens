{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hirelens/analysis.schema.json",
  "title": "AnalysisResult",
  "description": "The shape every backend must return and the API serves. Each strength quotes the resume (evidence) and each gap quotes the job description (requirement); the ML service verifies those quotes. Canonical source: src/analysis.ts mirrors this in zod, tests/test_schema_parity.py keeps them honest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fitScore",
    "verdict",
    "gaps",
    "strengths",
    "interviewQuestions"
  ],
  "properties": {
    "fitScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "How well the resume matches the JD. 0-100."
    },
    "verdict": {
      "type": "string",
      "minLength": 10,
      "maxLength": 240,
      "description": "One sentence summarising the match and its main weakness."
    },
    "gaps": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skill",
          "severity",
          "note",
          "requirement"
        ],
        "properties": {
          "skill": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "severity": {
            "type": "string",
            "enum": [
              "minor",
              "moderate",
              "severe"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 10,
            "maxLength": 240
          },
          "requirement": {
            "type": "string",
            "minLength": 8,
            "maxLength": 240,
            "description": "A short excerpt copied word for word from the job description that states this requirement."
          }
        }
      }
    },
    "strengths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "evidence"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "description": "The strength, in plain English."
          },
          "evidence": {
            "type": "string",
            "minLength": 8,
            "maxLength": 240,
            "description": "A short excerpt copied word for word from the resume that supports this strength."
          }
        }
      }
    },
    "interviewQuestions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "targets",
          "difficulty"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 15,
            "maxLength": 400
          },
          "targets": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "junior",
              "mid",
              "senior"
            ]
          }
        }
      }
    }
  }
}
